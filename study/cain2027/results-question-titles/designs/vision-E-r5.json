{
  "decisions": [
    {
      "decision": "How should the model serve predictions?",
      "context": "Cameras need local defect predictions on production lines that often lack network access.",
      "drivers": [
        "Intermittent connectivity",
        "On-device inference",
        "Tight budget"
      ],
      "alternatives": [
        {
          "label": "Local service/API based model serving",
          "value_id": "v:5.2",
          "citations": [
            "d:5",
            "v:5.2"
          ],
          "pros": [
            "Runs locally",
            "Real-time predictions"
          ],
          "cons": [
            "Requires local service operation"
          ]
        },
        {
          "label": "Microservice based model serving",
          "value_id": "v:5.1",
          "citations": [
            "d:5",
            "v:5.1"
          ],
          "pros": [
            "Distributed service boundary"
          ],
          "cons": [
            "Depends on network access"
          ]
        },
        {
          "label": "Data batch based model serving",
          "value_id": "v:5.3",
          "citations": [
            "d:5",
            "v:5.3"
          ],
          "pros": [
            "Scheduled processing"
          ],
          "cons": [
            "Predictions are not immediate"
          ]
        }
      ],
      "chosen": {
        "label": "Local service/API based model serving",
        "value_id": "v:5.2"
      },
      "rationale": "A local service can make predictions on-device without requiring a network connection, matching the deployment setting.",
      "consequences": [
        "Each device must run and expose the local prediction service."
      ]
    },
    {
      "decision": "When and how should the model be trained?",
      "context": "The model is retrained every week from newly labelled images.",
      "drivers": [
        "Weekly retraining",
        "New labelled images",
        "Small team"
      ],
      "alternatives": [
        {
          "label": "Batch-based learning",
          "value_id": "v:19.1",
          "citations": [
            "d:19",
            "v:19.1"
          ],
          "pros": [
            "Fits scheduled retraining",
            "Can train offline"
          ],
          "cons": [
            "Updates arrive in batches"
          ]
        },
        {
          "label": "Incremental learning",
          "value_id": "v:19.2",
          "citations": [
            "d:19",
            "v:19.2"
          ],
          "pros": [
            "Can incorporate data incrementally"
          ],
          "cons": [
            "Not required by weekly cadence"
          ]
        },
        {
          "label": "Hybrid batch-based and incremental learning",
          "value_id": "v:19.3",
          "citations": [
            "d:19",
            "v:19.3"
          ],
          "pros": [
            "Combines batch and incremental updates"
          ],
          "cons": [
            "More moving parts"
          ]
        }
      ],
      "chosen": {
        "label": "Batch-based learning",
        "value_id": "v:19.1"
      },
      "rationale": "A weekly batch training cycle matches the brief’s retraining cadence and avoids introducing incremental training complexity.",
      "consequences": [
        "Training runs on a weekly schedule using newly labelled images."
      ]
    },
