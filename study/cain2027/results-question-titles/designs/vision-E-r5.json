    {
      "decision": "How should deployed model versions be handled?",
      "context": "New weekly models are pushed to production devices, so a faulty update needs a recovery path.",
      "drivers": [
        "Weekly updates",
        "Production reliability",
        "On-device deployment"
      ],
      "alternatives": [
        {
          "label": "Rollback to previous model version",
          "value_id": "v:10.2",
          "citations": [
            "d:10",
            "v:10.2"
          ],
          "pros": [
            "Recovery from a bad update",
            "Uses a prior known version"
          ],
          "cons": [
            "Requires retaining prior model"
          ]
        },
        {
          "label": "N versions in production",
          "value_id": "v:10.1",
          "citations": [
            "d:10",
            "v:10.1"
          ],
          "pros": [
            "Multiple versions can coexist"
          ],
          "cons": [
            "More deployment complexity"
