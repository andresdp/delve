      ],
      "chosen": {
        "label": "Progressive release automation with rollback",
        "value_id": "v:19.5"
      },
      "rationale": "Progressive rollout with rollback limits the impact of a bad weekly model and provides a recovery path for deployed devices. The checked combination with on-device inference and automated hyperparameter optimization was novel and had no warnings; the alternative staged-release point was also novel.",
      "consequences": [
        "Keep a known-good model on each device.",
        "Track rollout and model versions.",
        "Allow devices to receive updates when connected."
      ]
