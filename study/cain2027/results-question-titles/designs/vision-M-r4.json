    {
      "decision": "Where should inference run?",
      "context": "Cameras must inspect products while production lines may have no network access. The brief also limits the team and infrastructure budget.",
      "drivers": [
        "Offline operation",
        "Small team",
        "Tight budget"
      ],
      "alternatives": [
        {
          "label": "On-device edge inference",
          "value_id": "v:30.4",
          "citations": [
            "s01_p06",
            "s07_p01",
            "s19_p11",
            "s24_p01",
            "s25_p07"
          ],
          "pros": [
            "Works without network",
            "Local predictions"
          ],
          "cons": [
            "Device deployment effort",
            "Hardware constraints"
          ]
        },
        {
          "label": "Containerized inference deployment",
          "value_id": "v:30.19",
          "citations": [
            "s04_p02",
            "s06_p07",
            "s07_p03",
            "s19_p17"
          ],
