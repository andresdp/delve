  }
  svg.on("click", () => clearSelection());

  // The trajectory: selecting a step (its column, its entry or its point in the graph) lights its point and its lineage.
  function stepInfo(s) {
    const sub = (s.approach ? "Approach " + esc(s.approach) + (s.round ? ", round " + esc(s.round) : "") + ". " : "") + esc(s.description || "");
    const inAdrs = adrOptions.filter(({ o }) => o.step === s.step);
    return head("Design point", "#" + s.step + " · " + esc(phrase(s)), sub)
