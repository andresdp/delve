{% macro value_ref(vid) -%}
{%- set v = d["values"].get(vid) if vid else none -%}
{%- if v -%}
<span class="vref" data-node="{{ v.id }}">{% if v.status %}<span class="dot {{ v.status }}"></span>{% endif %}{% if v.href %}<a href="{{ v.href }}">{{ v.label }}</a>{% else %}{{ v.label }}{% endif %}</span>
{%- else -%}<span class="muted">—</span>{%- endif -%}
{%- endmacro %}
{% macro dim_ref(did) -%}
{%- set x = d.dimensions.get(did) if did else none -%}
{%- if x -%}
<span class="dref" data-node="{{ x.id }}">{% if x.href %}<a href="{{ x.href }}">{{ x.label }}</a>{% else %}{{ x.label }}{% endif %}</span>
{%- else -%}<span class="muted">—</span>{%- endif -%}
{%- endmacro %}
{% macro value_short(vid, cls="") -%}
{%- set v = d["values"].get(vid) if vid else none -%}
{%- if v -%}
<span class="vref cell-v {{ cls }}" data-node="{{ v.id }}" title="{{ v.label }}">{% if v.status %}<span class="dot {{ v.status }}"></span>{% endif %}{{ v.label|truncate(26, true, "…") }}</span>
{%- endif -%}
{%- endmacro %}
{% macro drivers(ids) -%}
{% for r in ids %}<span class="chip small" data-node="r:{{ r }}">{{ r }}</span>{% endfor %}
{%- endmacro %}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ d.title }} · Explainer</title>
<link rel="stylesheet" href="{{ assets }}/style.css">
<link rel="icon" href="{{ assets }}/delvedspace-icon.svg" type="image/svg+xml">
<script>
  // Theme: the reader's choice (kept in this browser) or the system setting.
  (function () { try { var t = localStorage.getItem("delve-wiki-theme"); if (t) document.documentElement.dataset.theme = t; } catch (e) {} })();
</script>
<style>
  body { background: var(--bg); }
  .ex-wrap { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 0; min-height: calc(100vh - 50px); }
  .ex-text { padding: 22px 28px 60px; overflow-wrap: anywhere; }
  .ex-side { border-left: 1px solid var(--border); background: var(--panel); display: flex; flex-direction: column;
    position: sticky; top: 0; height: 100vh; }
  #canvas { position: relative; flex: 1 1 60%; min-height: 300px; overflow: hidden; }
  #svg { width: 100%; height: 100%; display: block; cursor: grab; }
  #info { flex: 1 1 40%; overflow-y: auto; padding: 12px 16px; border-top: 1px solid var(--border); font-size: 13.5px; }
  #info h2 { margin: 4px 0; font-size: 17px; border: none; }
  #info ul { padding-left: 16px; margin: 4px 0 10px; }
  #info .info-h { font-size: 11px; text-transform: uppercase; letter-spacing: .05em; color: var(--muted); margin: 14px 0 4px; font-weight: 600; }
  #info .info-sub { color: var(--muted); margin: 2px 0 8px; line-height: 1.45; }
  #info p { margin: 4px 0; line-height: 1.45; }
  #info .info-link { margin-top: 14px; }
  #info .node-chip { padding: 1px 7px; font-size: 11px; margin: 1px 3px 1px 0; }
  #info .pair-chip { display: inline-block; margin: 0 8px 4px 0; white-space: nowrap; }
  .muted, .hint { color: var(--muted); font-size: 12.5px; }
  h1 { margin: 6px 0 4px; font-size: 24px; }
  h2.sec { font-size: 16px; margin: 22px 0 8px; border: none; }
  .banner { background: var(--mixed); color: #fff; padding: 9px 14px; border-radius: 8px; margin: 0 0 14px; font-size: 14px; }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; padding: 0; margin: 6px 0; list-style: none; }
  .chip { display: inline-flex; gap: 6px; align-items: baseline; border: 1px solid var(--border); background: var(--panel);
    color: var(--fg); border-radius: 999px; padding: 4px 11px; font: inherit; font-size: 13px; cursor: pointer; text-align: left; }
  .chip strong { color: var(--accent); }
  .chip.small { padding: 0 7px; font-size: 11.5px; margin-right: 3px; }
  .chip:hover, .chip.sel { border-color: var(--accent); }
  .tabs { display: flex; flex-wrap: wrap; gap: 4px; border-bottom: 1px solid var(--border); margin: 18px 0 0; }
  .tab { font: inherit; font-size: 14px; padding: 7px 14px; border: 1px solid transparent; border-bottom: none;
    border-radius: 8px 8px 0 0; background: none; color: var(--muted); cursor: pointer; }
  .tab[aria-selected="true"] { background: var(--panel); border-color: var(--border); color: var(--fg); font-weight: 600;
    margin-bottom: -1px; }
  .panel { background: var(--panel); border: 1px solid var(--border); border-top: none; padding: 12px 16px 16px;
    border-radius: 0 0 8px 8px; }
  .panel[hidden] { display: none; }
  .choice { border-top: 1px solid var(--border); padding: 9px 0; }
  .choice:first-of-type { border-top: none; }
  .choice .head { display: flex; flex-wrap: wrap; gap: 6px; align-items: baseline; }
  .choice .arrow { color: var(--muted); }
  .choice p { margin: 4px 0; line-height: 1.45; font-size: 14px; }
  .quote { border-left: 3px solid var(--accent); padding: 2px 10px; margin: 6px 0; font-style: italic; }
  .ev { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12px; }
  .vref, .dref { cursor: pointer; display: inline-flex; gap: 5px; align-items: center; }
  .others { font-size: 12.5px; color: var(--muted); }
  .scroll { overflow-x: auto; }
  table.compare td.open { color: var(--muted); font-style: italic; }
  tr.differs th { border-left: 3px solid var(--accent); }
  .node text { font-size: 11px; fill: var(--fg); paint-order: stroke; stroke: var(--panel); stroke-width: 3px; pointer-events: none; }
  .node.greyed path.shape { opacity: .35; }
  .node.greyed text { opacity: .5; }
  .node.in-point text { font-weight: 600; }
  .link.explored { stroke: var(--accent); stroke-opacity: .7; stroke-width: 3px; }
  .link.on-path { stroke-opacity: 1; stroke-width: 4px; }
  .link.on-path.tree { stroke: var(--accent); }
  .link.shown { stroke-opacity: .95; stroke-width: 2.4px; }
  .graph-toggle { position: absolute; top: 8px; left: 10px; font-size: 12px; color: var(--muted); background: var(--panel);
    padding: 2px 6px; border-radius: 6px; display: flex; gap: 5px; align-items: center; cursor: pointer; }
  .node.dim-out, .link.dim-out { opacity: .1; }
  .graph-key { font-size: 11.5px; color: var(--muted); display: flex; flex-wrap: wrap; gap: 2px 12px; padding: 6px 12px;
    border-top: 1px solid var(--border); }
  .graph-key b { color: var(--fg); font-weight: 600; }
  .traj-wrap { position: relative; }
  svg.lineage { display: block; width: 100%; height: 46px; overflow: visible; }
  table.traj { border-collapse: separate; border-spacing: 0; font-size: 12.5px; overflow-wrap: normal; word-break: normal; hyphens: none; }
  table.traj th, table.traj td { padding: 4px 6px; border-bottom: 1px solid var(--border); vertical-align: top; }
  table.traj thead th { position: sticky; top: 0; background: var(--panel); }
  table.traj th.row-h { text-align: left; font-weight: 500; min-width: 140px; max-width: 220px; }
  table.traj .step-h { cursor: pointer; text-align: center; min-width: 112px; border-top: 3px solid var(--muted); }
  table.traj .step-h b { display: block; font-size: 14px; }
  table.traj .step-h .mv, table.traj .step-h .vd, table.traj .step-h .alt { display: block; font-size: 11px; }
  .mv-seed, .mv-solution { border-top-color: var(--dimension) !important; } .mv-seed .mv, .mv-solution .mv { color: var(--dimension); }
  .mv-exploit, .mv-region { border-top-color: var(--accent) !important; } .mv-exploit .mv, .mv-region .mv { color: var(--accent); }
  .mv-explore, .mv-contrast { border-top-color: var(--novel) !important; } .mv-explore .mv, .mv-contrast .mv { color: var(--novel); }
  .vd-strong, .vd-grounded { color: var(--accepted); } .vd-mixed, .vd-partial { color: var(--mixed); }
  .vd-weak, .vd-ungrounded { color: var(--rejected); }
  table.traj .alt { font-weight: 700; color: var(--fg); }
  table.traj td.c { text-align: left; min-width: 112px; max-width: 150px; }
  table.traj td.changed { box-shadow: inset 0 0 0 2px var(--accent); border-radius: 4px; }
  table.traj td.novel .cell-v { font-weight: 700; }
  table.traj td.contrast { box-shadow: inset 0 0 0 2px var(--novel); border-radius: 4px; }
  table.traj td.dropped { opacity: .55; }
  table.traj .sel { background: color-mix(in srgb, var(--accent) 14%, transparent); }
  table.traj .band-h { text-align: center; font-size: 12px; min-width: 40px; }
  table.traj td.band span { display: block; height: 18px; border-radius: 3px; background: var(--accepted); opacity: .75; }
  .cell-v { font-size: 12px; }
  .legend { font-size: 12px; color: var(--muted); display: flex; flex-wrap: wrap; gap: 4px 14px; margin: 6px 0; }
  .region { border: 1px solid var(--border); border-left: 4px solid var(--accepted); border-radius: 6px; padding: 8px 12px; margin: 8px 0; }
  .link.off { display: none; }
  .lanes-wrap, .qoc-wrap { position: relative; }
  svg.lane-arrows, svg.qoc-links { position: absolute; left: 0; top: 0; pointer-events: none; overflow: visible; }
  table.lanes { border-collapse: separate; border-spacing: 0; font-size: 13px; width: 100%; }
  table.lanes th, table.lanes td { border-bottom: 1px solid var(--border); padding: 8px 10px; text-align: left; vertical-align: middle; }
  table.lanes thead th { font-size: 12px; color: var(--muted); font-weight: 600; }
  table.lanes tbody th { min-width: 160px; max-width: 240px; font-weight: 400; }
  table.lanes .idea { display: block; color: var(--muted); font-size: 12px; }
  table.lanes tr.dropped th, table.lanes tr.dropped td:not(.outcome) { opacity: .7; }
  table.lanes td.outcome { font-size: 12px; max-width: 220px; }
  .node-chip { font: inherit; font-size: 12px; border-radius: 12px; padding: 3px 9px; margin: 2px 6px 2px 0; cursor: pointer;
    border: 2px solid var(--border); background: var(--panel); color: var(--fg); position: relative; z-index: 1; white-space: nowrap; }
  .node-chip small { color: var(--muted); }
  .vb-strong, .vb-grounded { border-color: var(--accepted) !important; } .vb-mixed, .vb-partial { border-color: var(--mixed) !important; }
  .vb-weak, .vb-ungrounded { border-color: var(--rejected) !important; }
  .node-chip.sel, .story-step.sel, .opt.sel { box-shadow: 0 0 0 3px var(--accent); }
  table.heat td.h.sel, table.heat th.sel { outline: 2px solid var(--fg); }
  .alt-chip { font-size: 12px; font-weight: 600; color: var(--accepted); }
  .dropped-mark { color: var(--rejected); font-weight: 600; }
  table.heat { border-collapse: separate; border-spacing: 2px; font-size: 11px; width: auto; }
  table.heat th, table.heat td { white-space: nowrap; }
  table.heat th { color: var(--muted); font-weight: 600; padding: 0 3px; }
  table.heat th.heat-r { text-align: left; border-bottom: 1px solid var(--border); }
  table.heat td.h { width: 26px; height: 18px; border-radius: 3px; cursor: pointer; }
  table.heat .rb { border-left: 6px solid var(--panel); }
  .h-meets { background: var(--accepted); } .h-partly { background: var(--mixed); } .h-misses { background: var(--rejected); }
  .h-none { background: var(--border); opacity: .5; }
  .sw { display: inline-block; width: 12px; height: 10px; border-radius: 2px; vertical-align: middle; margin-right: 3px; }
  .chip-sm { cursor: pointer; }
  .round-head { margin: 18px 0 6px; font-size: 14px; border-bottom: 2px solid var(--border); padding-bottom: 4px; }
  .round-end { color: var(--muted); font-size: 13px; margin-top: 12px; }
  .story-step { border: 1px solid var(--border); border-left: 4px solid var(--border); border-radius: 6px; padding: 8px 12px; margin: 8px 0; cursor: pointer; }
  .story-step.mv-explore, .story-step.mv-contrast { border-left-color: var(--novel); }
  .story-step.mv-exploit, .story-step.mv-region { border-left-color: var(--accent); }
  .story-step.mv-ablate { border-left-style: dotted; border-left-color: var(--accent); }
  .story-step.mv-seed, .story-step.mv-solution { border-left-color: var(--dimension); }
  .story-head { font-size: 14px; margin-bottom: 4px; }
  .story-step p { margin: 4px 0; line-height: 1.45; font-size: 13.5px; }
  .lbl { display: inline-block; min-width: 68px; font-size: 11px; text-transform: uppercase; letter-spacing: .04em; color: var(--muted); font-weight: 600; }
  .lbl-row { display: flex; gap: 0; font-size: 13px; } .lbl-row .lbl { padding-top: 2px; }
  ul.moves { margin: 0; padding-left: 16px; } ul.moves li { margin: 1px 0; }
  .vd-chip { font-size: 11px; border: 2px solid var(--border); border-radius: 10px; padding: 0 7px; margin-left: 4px; }
  .judged { margin: 4px 0; } .j { font-size: 11px; border-radius: 9px; padding: 1px 7px; margin: 2px 4px 2px 0; display: inline-block; color: #fff; cursor: pointer; }
  .j-meets { background: var(--accepted); } .j-partly { background: var(--mixed); } .j-misses { background: var(--rejected); }
  .qoc { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr); column-gap: 90px; font-size: 13px; }
  .qoc-hdr { display: grid; grid-template-columns: 1fr 1fr; color: var(--muted); font-size: 11px; text-transform: uppercase; font-weight: 600; margin-bottom: 4px; }
  .qoc-crit .qoc-hdr { grid-template-columns: 1fr; }
  .qoc-row { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; border-top: 1px solid var(--border); padding: 6px 0; align-items: center; }
  .opt { border: 1px solid var(--border); border-radius: 6px; padding: 3px 7px; margin: 3px 0; cursor: pointer; background: var(--panel); position: relative; z-index: 1; }
  .opt-solution { border-left: 4px solid var(--accent); } .opt-contrast { border-left: 4px solid var(--novel); }
  .crit { border: 1px solid var(--border); border-radius: 6px; padding: 5px 8px; margin: 6px 0; cursor: pointer; background: var(--panel); position: relative; z-index: 1; }
  svg.qoc-links path.traced { stroke-opacity: 1; stroke-width: 3px; }
  details.grid-details { margin-top: 22px; } details.grid-details summary { cursor: pointer; color: var(--muted); font-weight: 600; }
  .solution, .option { border: 1px solid var(--border); border-radius: 6px; padding: 8px 12px; margin: 8px 0; cursor: pointer; }
  .solution.sel, .option.sel { box-shadow: 0 0 0 2px var(--accent); }
  .adr { border-top: 1px solid var(--border); margin-top: 18px; padding-top: 8px; }
  .adr h3 { margin: 6px 0; font-size: 16px; }
  .option.chosen { border-left: 4px solid var(--accepted); }
  .option.discarded { border-left: 4px solid var(--rejected); opacity: .9; }
  .option .values { font-size: 13px; margin: 4px 0; }
  ul.pc { list-style: none; padding: 0; margin: 4px 0; font-size: 13px; }
  ul.pc li::before { font-weight: 700; margin-right: 6px; }
  ul.pc li.pro::before { content: "+"; color: var(--accepted); }
  ul.pc li.con::before { content: "−"; color: var(--rejected); }
  ul.parts { margin: 4px 0 6px; padding-left: 18px; font-size: 13px; }
  ul.parts li { margin: 4px 0; }
  .pairs { display: block; margin: 2px 0; }
  .pairs .pair { display: block; padding-left: 10px; font-size: 13px; }
  .node.unjudged path.shape { fill: var(--panel); stroke: var(--rejected); stroke-dasharray: 2,2; stroke-width: 1.5px; }
  @media (max-width: 900px) {
    .ex-wrap { grid-template-columns: 1fr; }
    .ex-text { padding: 16px 16px 30px; }
    .ex-side { position: static; height: auto; border-left: none; border-top: 1px solid var(--border); }
    #canvas { height: 420px; flex: none; }
  }
</style>
</head>
<body class="page-explainer">
<header class="top">
  {% if d.links.index %}<a class="brand" href="{{ d.links.index }}">{% else %}<span class="brand">{% endif %}<img src="{{ assets }}/delvedspace-icon.svg" alt="" class="brand-icon" width="32" height="32">{{ d.space.domain if d.space else "Design rationale" }}{% if d.links.index %}</a>{% else %}</span>{% endif %}
  <nav>{% if d.links.index %}<a href="{{ d.links.index }}">Wiki index</a>{% endif %}{% if d.links.graph %}<a href="{{ d.links.graph }}">Graph</a>{% endif %}</nav>
  <button class="theme-btn" id="theme-toggle" type="button" title="Switch light / dark mode" aria-label="Switch light / dark mode" style="margin-left:auto">◐</button>
</header>
<div class="ex-wrap">
<main class="ex-text">
  {% if d.graph_changed %}<div class="banner" role="status">The graph changed since this rationale was written: its ids were checked against the current graph, but labels, values and evidence may differ from what the agent saw.</div>{% endif %}
  <div class="kind">{{ "Explain" if d.mode == "explain" else "Search" }} · design rationale{% if d.space %} · run {{ d.space.run }}{% else %} · no design space{% endif %}</div>
  <h1>{{ d.title }}</h1>
  {% if d.context %}<p>{{ d.context }}</p>{% endif %}

  <h2 class="sec">Requirements</h2>
  <ul class="chips" id="requirements">
    {% for r in d.requirements %}
    <li><button class="chip" type="button" data-requirement="{{ r.id }}" data-node="r:{{ r.id }}"><strong>{{ r.id }}</strong> {{ r.text }}{% if r.kind %} <span class="muted">{{ r.kind }}{% if r.attribute %}: {{ r.attribute }}{% endif %}</span>{% endif %}</button></li>
    {% endfor %}
  </ul>

  {% set search = d.mode != "explain" %}
  <div class="tabs" role="tablist">
    <button class="tab" type="button" role="tab" data-tab="adrs" aria-selected="true">{{ "Decisions (ADRs)" }}</button>
    {% if d.alternatives|length > 1 %}
    <button class="tab" type="button" role="tab" data-tab="compare" aria-selected="false">Comparison</button>
    {% endif %}
    {% if d.trajectory %}<button class="tab" type="button" role="tab" data-tab="trajectory" aria-selected="false">Trajectory</button>{% endif %}
  </div>

  <section class="panel" data-panel="adrs">
    <p class="hint">{% if search %}The alternatives the agent proposes, then its decisions as architecture decision records: each ADR addresses a few related requirements and weighs options (partial design points), chosen by one or more alternatives or discarded.{% else %}The solution, then its decisions as architecture decision records: each ADR addresses a few related requirements, with the solution's option and the options it was contrasted with.{% endif %} Select an alternative or an option to see it in the graph.</p>
    <h2 class="sec">{{ "Alternatives" if search else "The solution" }}</h2>
    {% for a in d.alternatives %}
    <div class="solution" data-alt="{{ a.id }}" tabindex="0"><strong>{{ a.id }} · {{ a.name }}</strong>
      {% if a.summary %}<p>{{ a.summary }}</p>{% endif %}
      {% if a.parts %}
      <p class="muted">Composed of {{ a.parts|length }} partial design point{{ "s" if a.parts|length != 1 }}, one per ADR:</p>
      <ul class="parts">
        {% for part in a.parts %}
        <li><a href="#adr-{{ part.adr }}" class="adr-link">{{ part.adr }}</a> · {{ part.name }} {{ drivers(part.drivers) }}
          <span class="pairs">{% for did, vid in part.point.items() %}<span class="pair">{{ dim_ref(did) }} → {{ value_ref(vid) }}</span>{% endfor %}</span></li>
        {% endfor %}
      </ul>
      {% endif %}
      {% if a.point %}<p class="muted">As a whole: {{ a.point }}</p>{% endif %}
      {% if a.open %}<p class="muted">Left open: {% for o in a.open %}{{ dim_ref(o.dimension) }}{% if o.reason %} ({{ o.reason }}){% endif %}{% if not loop.last %} · {% endif %}{% endfor %}</p>{% endif %}
    </div>
    {% endfor %}
    {% for adr in d.adrs %}
    <article class="adr" id="adr-{{ adr.id }}">
      <h3>{{ adr.id }} · {{ adr.title }} {{ drivers(adr.drivers) }}</h3>
      {% if adr.context %}<p><strong>Context.</strong> {{ adr.context }}</p>{% endif %}
      {% set chosen = adr.options|selectattr("status", "equalto", "chosen")|list %}
      <p><strong>Decision.</strong> {% for o in chosen %}{{ o.name }}{% if search %} <span class="muted">({{ o["in"]|join(", ") }})</span>{% endif %}{% if not loop.last %}; {% endif %}{% endfor %}.</p>
      {% for o in adr.options %}
      <div class="option {{ o.status }}" data-option="{{ o.key }}" tabindex="0">
        <div class="head"><strong>{{ o.name }}</strong> <span class="badge {{ 'accepted' if o.status == 'chosen' else 'rejected' }}">{{ ("chosen in " ~ o["in"]|join(", ")) if o.status == "chosen" and search else o.status }}</span></div>
        <p class="values pairs">{% for did, vid in o.point.items() %}<span class="pair">{{ dim_ref(did) }} → {{ value_ref(vid) }}</span>{% endfor %}</p>
        {% for q in o.quotes %}<div class="quote">“{{ q }}”</div>{% endfor %}
        {% if o.pros or o.cons %}<ul class="pc">{% for x in o.pros %}<li class="pro">{{ x }}</li>{% endfor %}{% for x in o.cons %}<li class="con">{{ x }}</li>{% endfor %}</ul>{% endif %}
        {% if o.reason %}<p>{{ o.reason }}</p>{% endif %}
      </div>
      {% endfor %}
      {% if adr.consequences %}<p><strong>Consequences.</strong> {{ adr.consequences }}</p>{% endif %}
    </article>
    {% endfor %}
    <h2 class="sec">Requirements not addressed</h2>
    {% if d.unaddressed %}
    <p class="hint">No ADR and no decision names these requirements as drivers.</p>
    <ul class="chips">{% for rid in d.unaddressed %}{% set r = d.requirements|selectattr("id", "equalto", rid)|first %}<li><button class="chip" type="button" data-requirement="{{ rid }}" data-node="r:{{ rid }}"><strong>{{ rid }}</strong> {{ r.text }}</button></li>{% endfor %}</ul>
    {% else %}
    <p>Every requirement is addressed by an ADR or a decision.</p>
    {% endif %}
  </section>

  {% if d.trajectory %}
  {% set solution = (d.trajectory|selectattr("move", "equalto", "solution")|first) if not search else none %}
  <section class="panel" data-panel="trajectory" hidden>
    {% set rounds = d.lanes.rounds if d.lanes else [] %}
    <p class="hint">{% if search %}How the agent searched the space: {{ d.budget.used }} design point{{ "s" if d.budget.used != 1 }} evaluated{% if d.budget.max_points %} of a budget of {{ d.budget.max_points }}{% endif %}, in {{ rounds|length }} round{{ "s" if rounds|length != 1 }} over {{ d.lanes.lanes|length }} approaches. The lanes give the overview; the strip shows how each point met each requirement; the story below follows the agent's thinking round by round.{% else %}How the agent explained the solution: {{ d.budget.used }} point{{ "s" if d.budget.used != 1 }} or region{{ "s" if d.budget.used != 1 }} evaluated{% if d.budget.max_points %} of a budget of {{ d.budget.max_points }}{% endif %}. The story follows the agent's thinking step by step; the questions, options and criteria then show which of the solution's choices the requirements force.{% endif %} Select a point anywhere to see it in the graph.</p>

    {% if search and d.lanes %}
    <h2 class="sec">Approaches and rounds</h2>
    <div class="scroll lanes-wrap">
      <svg class="lane-arrows" aria-hidden="true"></svg>
      <table class="lanes">
        <thead><tr><th>Approach</th>{% for r in rounds %}<th>Round {{ r }}</th>{% endfor %}<th>Outcome</th></tr></thead>
        <tbody>
          {% for lane in d.lanes.lanes %}
          <tr class="lane {{ lane.status }}">
            <th><b>{{ lane.approach }}</b> <span class="idea">{{ lane.idea }}</span></th>
            {% for r in rounds %}<td>{% for c in lane.cells.get(r, []) %}<button type="button" class="node-chip vb-{{ c.verdict }}" data-step="{{ c.step }}" title="{{ c.why }}">#{{ c.step }} <small>{{ c.move }}</small></button>{% endfor %}</td>{% endfor %}
            <td class="outcome">{% if lane.alternative %}<span class="alt-chip">→ {{ lane.alternative }}</span>{% elif lane.status == "dropped" %}<span class="dropped-mark">✕ dropped</span> <span class="muted">{{ lane.dropped_because }}</span>{% else %}<span class="muted">not proposed</span>{% endif %}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    <div class="legend"><span><b style="color:var(--accepted)">strong</b> · <b style="color:var(--mixed)">mixed</b> · <b style="color:var(--rejected)">weak</b> points</span><span>— refine, on its lane</span><span>- - a new approach started from a point</span><span>··· an ablation</span></div>

    <h2 class="sec">Requirements, point by point</h2>
    <div class="scroll"><table class="heat">
      <thead>
        <tr><th></th>{% for r in rounds %}<th class="heat-r" colspan="{{ d.trajectory|selectattr('round', 'equalto', r)|list|length }}">Round {{ r }}</th>{% endfor %}</tr>
        <tr><th></th>{% for s in d.trajectory %}<th class="heat-h{% if loop.index0 and s.round != d.trajectory[loop.index0 - 1].round %} rb{% endif %}" data-step="{{ s.step }}" title="{{ s.verdict }}">#{{ s.step }}</th>{% endfor %}</tr>
      </thead>
      <tbody>
        {% for req in d.requirements %}
        <tr><th><span class="chip-sm" data-node="r:{{ req.id }}" title="{{ req.text }}">{{ req.id }}</span></th>
          {% for s in d.trajectory %}{% set j = s.assessment.get(req.id) %}<td class="h h-{{ j or 'none' }}{% if loop.index0 and s.round != d.trajectory[loop.index0 - 1].round %} rb{% endif %}" data-step="{{ s.step }}" title="#{{ s.step }} · {{ req.id }}: {{ j or 'not judged' }}"></td>{% endfor %}
        </tr>
        {% endfor %}
      </tbody>
    </table></div>
    <div class="legend"><span><i class="sw h-meets"></i> meets</span><span><i class="sw h-partly"></i> partly</span><span><i class="sw h-misses"></i> misses</span><span><i class="sw h-none"></i> not judged by that point</span></div>
    {% endif %}

    {% macro phrase(s) -%}
    {%- if s.move == "seed" %}Seed of approach {{ s.approach }}
    {%- elif s.move == "exploit" %}Refined #{{ s.parent }}{% if s.approach %} (approach {{ s.approach }}){% endif %}
    {%- elif s.move == "explore" %}New approach {{ s.approach }}{% if s.parent %}, started from #{{ s.parent }}{% endif %}
    {%- elif s.move == "ablate" %}Ablation of #{{ s.parent }}: which value made it work?
    {%- elif s.move == "solution" %}The solution as one design point
    {%- elif s.move == "region" %}A region of #{{ s.parent }}: part of the solution
    {%- elif s.move == "contrast" %}A contrast on #{{ s.parent }}: one option changed
    {%- else %}{{ s.move }}{% endif -%}
    {%- endmacro %}
    {% macro story(s, search) %}
    <article class="story-step mv-{{ s.move }}" data-step="{{ s.step }}">
      <div class="story-head"><b>#{{ s.step }}</b> {{ phrase(s) }} <span class="vd-chip vb-{{ s.verdict }}">{{ s.verdict }}</span>{% if s.alternative %} <span class="alt-chip">{{ "→ " ~ s.alternative if search else "the solution" }}</span>{% endif %}</div>
      {% if s.why %}<p><span class="lbl">Thought</span> {{ s.why }}</p>{% endif %}
      <div class="lbl-row"><span class="lbl">Move</span>
        <ul class="moves">
          {% if s.move in ("seed", "solution", "region") or not s.diff or s.parent is none %}
          {% for did, vid in s.point.items() %}<li>{{ dim_ref(did) }} → {{ value_ref(vid) }}</li>{% endfor %}
          {% else %}
          {% for c in s.diff %}<li>{% if c.before is none %}add {{ dim_ref(c.dimension) }} → {{ value_ref(c.after) }}{% elif c.after is none %}drop {{ dim_ref(c.dimension) }} <span class="muted">(was {{ value_ref(c.before) }})</span>{% else %}change {{ dim_ref(c.dimension) }}: {{ value_ref(c.before) }} → {{ value_ref(c.after) }}{% endif %}</li>{% endfor %}
          {% endif %}
        </ul>
      </div>
      {% if s.observation %}<p><span class="lbl">Observed</span> {{ s.observation }}</p>{% endif %}
      {% if s.assessment %}<div class="judged">{% for rid, j in s.assessment.items() %}<span class="j j-{{ j }}" data-node="r:{{ rid }}">{{ rid }} {{ j }}</span>{% endfor %}</div>{% endif %}
      {% if s.description %}<p class="muted">{{ s.description }}</p>{% endif %}
      {% if d.wiki %}<p class="muted">{% if s.attested_by %}Attested by {% for a in s.attested_by %}{% if a.href %}<a href="{{ a.href }}">{{ a.label }}</a>{% else %}{{ a.label }}{% endif %}{% if not loop.last %}; {% endif %}{% endfor %}{% else %}No source attests this combination.{% endif %}</p>{% endif %}
    </article>
    {% endmacro %}

    <h2 class="sec">{{ "The search, round by round" if search else "The explanation, step by step" }}</h2>
    {% if search and rounds %}
    {% for r in rounds %}
    {% set in_round = d.trajectory|selectattr("round", "equalto", r)|list %}
    <div class="round-head"><b>Round {{ r }}</b> · {{ in_round|length }} point{{ "s" if in_round|length != 1 }}: {% for s in in_round %}{{ {"seed": "seed", "exploit": "refine", "explore": "new approach", "ablate": "ablate"}.get(s.move, s.move) }} {{ s.approach }}{% if not loop.last %}, {% endif %}{% endfor %}</div>
    {% for s in in_round %}{{ story(s, search) }}{% endfor %}
    {% endfor %}
    <p class="round-end">Stopped after round {{ rounds|last }}: {{ d.budget.used }} of {{ d.budget.max_points or d.budget.used }} points used.</p>
    {% else %}
    {% for s in d.trajectory %}{{ story(s, search) }}{% endfor %}
    {% endif %}

    {% if not search and d.qoc %}
    <h2 class="sec">Questions, options and criteria</h2>
    <p class="hint">Each question is a dimension the solution settles; its options are the solution's value and the values contrasts tried; each option links to the requirements (criteria), as judged by the most specific point that evaluated it. Links of an option judged only within the whole solution are faint; hover an option to trace its links.</p>
    <div class="qoc-wrap">
      <svg class="qoc-links" aria-hidden="true"></svg>
      <div class="qoc">
        <div class="qoc-left">
          <div class="qoc-hdr"><span>Question</span><span>Options</span></div>
          {% for q in d.qoc %}{% set qi = loop.index0 %}
          <div class="qoc-row"><div class="q">{{ dim_ref(q.dimension) }}</div>
            <div class="opts">{% for o in q.options %}<div class="opt opt-{{ o.kind }}" data-qoc="{{ qi }}:{{ loop.index0 }}" data-step="{{ o.step }}">{{ value_ref(o.value) }} <span class="muted">{% if o.kind == "solution" %}the solution{% if o.forced is sameas true %} · forced{% elif o.forced is sameas false %} · free{% endif %}{% if not o.specific %} · judged only within the whole solution{% endif %}{% else %}contrast #{{ o.step }}{% endif %}</span></div>{% endfor %}</div>
          </div>
          {% endfor %}
        </div>
        <div class="qoc-crit">
          <div class="qoc-hdr"><span>Criteria</span></div>
          {% for req in d.requirements %}<div class="crit" data-crit="{{ req.id }}" data-node="r:{{ req.id }}"><b>{{ req.id }}</b> {{ req.text }}</div>{% endfor %}
        </div>
      </div>
    </div>
    <div class="legend"><span><b style="color:var(--accepted)">——</b> meets</span><span><b style="color:var(--mixed)">——</b> partly</span><span><b style="color:var(--rejected)">- - -</b> misses</span></div>
    {% endif %}

    {% if d.regions %}
    <h2 class="sec">Regions that justify the solution</h2>
    {% for r in d.regions %}
    <div class="region" data-step="{{ r.step }}"><strong>{{ r.id }} · {{ r.name }}</strong> {{ drivers(r.drivers) }} <span class="muted">investigated at step {{ r.step }}</span>
      <p>{% for did, vid in r.point.items() %}{{ dim_ref(did) }} → {{ value_ref(vid) }}{% if not loop.last %} · {% endif %}{% endfor %}</p>
      {% if r.reason %}<p>{{ r.reason }}</p>{% endif %}
    </div>
    {% endfor %}
    {% endif %}
    <details class="grid-details"><summary>Dimension grid: every point, dimension by dimension</summary>
    <div class="legend">
      {% if search %}<span><b class="mv-seed" style="color:var(--dimension)">seed</b> a starting point</span><span><b style="color:var(--accent)">exploit</b> options added or changed against the step it starts from (outlined)</span><span><b style="color:var(--novel)">explore</b> a new part of the space (new options in bold)</span>
      {% else %}<span><b style="color:var(--dimension)">solution</b> the solution as a point</span><span><b style="color:var(--accent)">region</b> a part of it</span><span><b style="color:var(--novel)">contrast</b> an option changed (outlined)</span>{% endif %}
    </div>
    <div class="scroll traj-wrap">
      <svg class="lineage" aria-hidden="true"></svg>
      <table class="traj">
        <thead><tr><th class="row-h">{{ "Dimension" if d.with_space else "Decision" }}</th>
          {% for r in d.regions %}<th class="band-h" title="{{ r.name }}">{{ r.id }}</th>{% endfor %}
          {% for s in d.trajectory %}<th class="step-h mv-{{ s.move }}" data-step="{{ s.step }}" title="{{ s.why }}"><b>{{ s.step }}</b><span class="mv">{{ s.move }}</span><span class="vd vd-{{ s.verdict }}">{{ s.verdict }}</span>{% if s.alternative %}<span class="alt">→ {{ s.alternative }}</span>{% endif %}</th>{% endfor %}
        </tr></thead>
        <tbody>
          {% for did in d.trajectory_dimensions %}
          <tr><th class="row-h">{{ dim_ref(did) }}</th>
            {% for r in d.regions %}<td class="band" title="{{ r.name }}">{% if did in r.point %}<span></span>{% endif %}</td>{% endfor %}
            {% for s in d.trajectory %}
            {% set vid = s.point.get(did) %}
            {% if search %}
            <td class="c{% if did in s.changed %} changed{% endif %}{% if did in s.novel and s.move == 'explore' %} novel{% endif %}{% if s.verdict == 'weak' %} dropped{% endif %}" data-step="{{ s.step }}">{{ value_short(vid) }}</td>
            {% else %}
            {% set sol = solution.point.get(did) if solution else none %}
            <td class="c{% if vid and sol and vid != sol %} contrast{% endif %}" data-step="{{ s.step }}">{{ value_short(vid) }}</td>
            {% endif %}
            {% endfor %}
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    </details>
  </section>
  {% endif %}
  {% if d.alternatives|length > 1 %}
  <section class="panel" data-panel="compare" hidden>
    <p class="hint">One row per dimension involved; the rows where the alternatives differ come first.</p>
    <div class="scroll"><table class="compare">
      <thead><tr><th>{{ "Dimension" if d.with_space else "Decision" }}</th>{% for a in d.alternatives %}<th>{{ a.id }} · {{ a.name }}</th>{% endfor %}</tr></thead>
      <tbody>
        {% for row in d.rows %}
        <tr class="row{% if row.differs %} differs{% endif %}" data-dimension="{{ row.dimension }}">
          <th>{{ dim_ref(row.dimension) }}{% if row.note %}<div class="muted">{{ row.note }}</div>{% endif %}</th>
          {% for c in row.cells %}
          {% if c.kind == "choice" %}<td>{{ value_ref(c.value) }}</td>{% elif c.kind == "open" %}<td class="open" title="{{ c.reason }}">open</td>{% else %}<td class="open">—</td>{% endif %}
          {% endfor %}
        </tr>
        {% endfor %}
      </tbody>
    </table></div>
  </section>
  {% endif %}

  {% if d.mode == "explain" or d.uncovered %}
  <h2 class="sec">Uncovered decisions</h2>
  {% if d.uncovered %}
  <p class="hint">Decisions in the solution that the agent could not map onto a dimension of the space.</p>
  {% for u in d.uncovered %}
  <div class="choice"><div class="head"><strong>{{ u.decision }}</strong>{% if u.nearest %} <span class="muted">nearest:</span> {% if u.nearest.href %}<a href="{{ u.nearest.href }}">{{ u.nearest.label }}</a>{% else %}{{ u.nearest.label }}{% endif %}{% endif %}</div>
    <div class="quote">“{{ u.quote }}”</div></div>
  {% endfor %}
  {% else %}
  <p>None: every decision mapped.</p>
  {% endif %}
  {% endif %}
</main>
<aside class="ex-side">
  <div id="canvas"><svg id="svg" role="img" aria-label="The dimensions this rationale involves"></svg>
    <label class="graph-toggle"><input type="checkbox" id="show-all"> Show every value the space offers</label></div>
  <div class="graph-key"><span>from the centre: dimensions, values, <b>design points</b> (▲, one per step, coloured by its rating), requirements (■, linked by how each point meets them)</span><span><b>blue</b>: explored paths</span><span><b>outlined</b>: the design point shown</span><span>select a node: its path to the centre and the paths from it to design points and requirements</span></div>
  <div id="info"><p class="hint">Select a dimension, value or requirement (in the graph or the text) to see its details.</p></div>
</aside>
</div>
<script type="application/json" id="explainer-data">{{ data|safe }}</script>
<script>
  (function () {
    var root = document.documentElement, btn = document.getElementById("theme-toggle");
    function current() {
      return root.dataset.theme || (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
    }
    function label() { btn.textContent = current() === "dark" ? "☀" : "☾"; }
    btn.addEventListener("click", function () {
      var next = current() === "dark" ? "light" : "dark";
      root.dataset.theme = next;
      try { localStorage.setItem("delve-wiki-theme", next); } catch (e) {}
      label();
      document.dispatchEvent(new CustomEvent("themechange"));
    });
    label();
  })();
</script>
<script src="{{ assets }}/d3.min.js"></script>
<script src="{{ assets }}/graph-layout.js"></script>
<script>
(function () {
  const data = JSON.parse(document.getElementById("explainer-data").textContent);
  const COLOR = {};
  function readColors() {
    const cs = getComputedStyle(document.documentElement), get = (name) => cs.getPropertyValue(name).trim();
    ["dimension", "source", "accepted", "mixed", "rejected", "outcome", "muted", "fg", "accent", "novel"]
      .forEach((k) => { COLOR[k] = get("--" + k); });
  }
  readColors();
  const esc = (t) => String(t ?? "").replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]));
  const alts = data.alternatives;
  const altName = (a) => a.id + " · " + a.name;

  // The subgraph, as a tree from the centre: the domain, the involved dimensions, their values, then the design
  // points the agent evaluated (one per step), then the requirements on the outer ring, linked to the points
  // whose assessment judges them.
  const steps = data.trajectory || [];
  const pointValues = new Set();  // explored: every value a design point of the page takes (a step's or a choice's)
  steps.forEach((s) => Object.values(s.point).forEach((v) => pointValues.add(v)));
  alts.forEach((a) => a.choices.forEach((c) => c.value && pointValues.add(c.value)));
  const consideredValues = new Set();
  alts.forEach((a) => a.considered.forEach((c) => c.value && consideredValues.add(c.value)));
  const options = new Map();  // "ADR:option" -> option, from every ADR
  (data.adrs || []).forEach((r) => r.options.forEach((o) => {
    options.set(o.key, o); Object.values(o.point).forEach((v) => consideredValues.add(v)); }));
  const exploredDims = new Set([...pointValues].map((v) => (data.values[v] || {}).dimension).filter(Boolean));
  const nodes = [{ id: "domain", kind: "domain", label: data.space ? (data.space.domain || "") : data.title }];
  const edges = [];
  Object.values(data.dimensions).forEach((dm) => {
    nodes.push({ ...dm, kind: "dimension" });
    edges.push({ source: "domain", target: dm.id, type: "domain" });
    dm.values.forEach((vid) => edges.push({ source: dm.id, target: vid, type: "has_value" }));
  });
  Object.values(data.values).forEach((v) => nodes.push({ ...v, kind: "value" }));
  const pid = (n) => "p:" + n;
  steps.forEach((s) => {
    nodes.push({ id: pid(s.step), kind: "point", step: s.step, verdict: s.verdict, values: Object.values(s.point),
      label: (s.alternative ? s.alternative + " · " : "") + "#" + s.step, description: s.description });
    Object.values(s.point).forEach((v) => edges.push({ source: v, target: pid(s.step), type: "member" }));
    Object.entries(s.assessment || {}).forEach(([r, judged]) =>
      edges.push({ source: pid(s.step), target: "r:" + r, type: "assess", judged }));
  });
  data.relations.forEach((r) => edges.push({ source: r.source, target: r.target, type: "relation", relation: r.type,
    directed: r.directed, reading: r.reading }));
  data.requirements.forEach((r) => nodes.push({ ...r, id: "r:" + r.id, req: r.id, kind: "requirement", label: r.id }));
  const byId = new Map(nodes.map((n) => [n.id, n]));
  const links = edges.filter((e) => byId.has(e.source) && byId.has(e.target));
  const TREE = new Set(["domain", "has_value", "member"]);

  const SYMBOL = { domain: d3.symbolCircle, dimension: d3.symbolCircle, value: d3.symbolDiamond, point: d3.symbolTriangle,
    requirement: d3.symbolSquare };
  const radius = (n) => n.kind === "domain" ? 14 : n.kind === "dimension" ? 10 : n.kind === "value" ? 6 : n.kind === "point" ? 8 : 7;
  const shapePath = (n) => d3.symbol().type(SYMBOL[n.kind] || d3.symbolCircle)
    .size(Math.PI * radius(n) * radius(n) * (n.kind === "value" ? 1.25 : 1))();
  const JUDGED = { strong: "accepted", grounded: "accepted", mixed: "mixed", partial: "mixed", weak: "rejected",
    ungrounded: "rejected", meets: "accepted", partly: "mixed", misses: "rejected" };
  const nodeColor = (n) => n.kind === "value" ? (COLOR[n.status] || COLOR.accent) : n.kind === "domain" ? COLOR.fg
    : n.kind === "requirement" ? COLOR.novel : n.kind === "point" ? (COLOR[JUDGED[n.verdict]] || COLOR.accent) : COLOR.dimension;

  // The shared radial layout (graph-layout.js). Dimension labels point inwards, so each dimension sits just inside
  // its values; the other rings start beyond the longest label of the ring inside them. Points (in step order,
  // clockwise from the top) and requirements sit evenly around their rings.
  const LABEL_MAX = 36;
  const shortLabel = (s) => { s = String(s ?? ""); return s.length > LABEL_MAX ? s.slice(0, LABEL_MAX - 1).trimEnd() + "…" : s; };
  const measure = (() => {
    const ctx = document.createElement("canvas").getContext("2d");
    ctx.font = "11px " + getComputedStyle(document.body).fontFamily;
    return (s) => ctx ? ctx.measureText(s).width : s.length * 6.5;
  })();
  const labelReach = (ns) => d3.max(ns, (n) => radius(n) + 4 + measure(shortLabel(n.label)) + 3) || 0;
  const radialTargets = (nodes, links, cx, cy) => DelveLayout.radialTargets(nodes, links, cx, cy, {
    rings: ["domain", "dimension", "value", "point", "requirement"],
    spacing: { dimension: 90, value: 30, point: 34, requirement: 40 }, ringGap: 70,
    labelReach, restJitter: 0.04, inward: ["dimension"], inset: { dimension: 36 }, even: ["point", "requirement"] });

  const svg = d3.select("#svg"), g = svg.append("g");
  svg.append("defs").append("marker").attr("id", "arrow").attr("viewBox", "0 -5 10 10").attr("refX", 20).attr("refY", 0)
    .attr("markerWidth", 6).attr("markerHeight", 6).attr("orient", "auto")
    .append("path").attr("d", "M0,-5L10,0L0,5").attr("fill", COLOR.dimension);
  const zoom = d3.zoom().scaleExtent([0.2, 6]).on("zoom", (ev) => g.attr("transform", ev.transform));
  svg.call(zoom);
  const linkLayer = g.append("g"), nodeLayer = g.append("g");
  const REL_DASH = { requires: null, affects: "7,3", constrains: "2,3", co_occurs_with: "1,5", refines: "9,3,2,3" };
  function edgeStyle(e) {
    if (e.type === "relation") return { stroke: COLOR.dimension, width: 2, dash: REL_DASH[e.relation] || null, op: 0.85, arrow: e.directed !== false };
    if (e.type === "assess") return { stroke: COLOR[JUDGED[e.judged]] || COLOR.muted, width: 1.2, dash: e.judged === "misses" ? "4,3" : null, op: 0.22 };
    if (e.type === "member") return { stroke: COLOR.muted, width: 1, dash: null, op: 0.12 };
    if (e.type === "domain") return { stroke: COLOR.muted, width: 0.8, dash: null, op: 0.3 };
    return { stroke: COLOR.muted, width: 1, dash: null, op: 0.5 };
  }
  const width = () => document.getElementById("canvas").clientWidth;
  const height = () => document.getElementById("canvas").clientHeight;
  const cx = 0, cy = 0;  // the layout's own frame; fit() maps it onto the canvas
  const pos = (id) => byId.get(id);
  const linkSel = linkLayer.selectAll("line").data(links).enter().append("line")
    .attr("class", (d) => "link" + (TREE.has(d.type) ? " tree" : ""));
  function styleLinks() {
    linkSel.each(function (d) { const st = edgeStyle(d); d3.select(this).attr("stroke", st.stroke).attr("stroke-width", st.width)
      .attr("stroke-dasharray", st.dash).attr("stroke-opacity", st.op).attr("marker-end", st.arrow ? "url(#arrow)" : null); });
  }
  styleLinks();
  linkSel.filter((d) => d.reading).append("title").text((d) => d.reading);
  linkSel.filter((d) => d.type === "assess").append("title").text((d) => byId.get(d.source).label + " " + d.judged + " " + d.target.slice(2));
  const nodeSel = nodeLayer.selectAll("g.node").data(nodes).enter().append("g").attr("class", "node")
    .style("cursor", "pointer").on("click", (ev, d) => { ev.stopPropagation(); select(d.id); });
  nodeSel.append("circle").attr("r", (d) => Math.max(radius(d), 10)).attr("fill", "transparent");
  nodeSel.append("path").attr("class", "shape").attr("d", shapePath);
  nodeSel.append("text").text((d) => d.kind === "domain" ? d.label : shortLabel(d.label));
  nodeSel.append("title").text((d) => d.kind === "requirement" ? d.req + ": " + d.text
    : d.kind === "point" ? "Step " + d.step + " · " + d.verdict + (d.description ? ": " + d.description : "")
    : d.label + (d.status ? " (" + d.status + ")" : ""));
  const orientLabels = () => DelveLayout.orientLabels(nodeSel.select("text"), cx, cy, { radius, centreDy: "-1.4em",
    inward: (d) => d.kind === "dimension" });
  function fit() {
    const shown = nodes.filter(visible);
    const xs = shown.map((d) => d.x), ys = shown.map((d) => d.y), pad = 120;
    const x0 = Math.min(...xs), x1 = Math.max(...xs), y0 = Math.min(...ys), y1 = Math.max(...ys);
    const k = Math.min(2.5, 0.95 / Math.max((x1 - x0 + 2 * pad) / (width() || 1), (y1 - y0 + 2 * pad) / (height() || 1)));
    svg.call(zoom.transform, d3.zoomIdentity.translate(width() / 2, height() / 2).scale(k).translate(-(x0 + x1) / 2, -(y0 + y1) / 2));
  }
  // Shown: every node but the values no design point takes and no alternative considered, unless the reader asks
  // for every value the space offers. The layout is computed over the shown nodes only.
  let showAll = false;
  const visible = (d) => d.kind !== "value" || showAll || pointValues.has(d.id) || consideredValues.has(d.id);
  function layout() {
    const shown = nodes.filter(visible), ids = new Set(shown.map((n) => n.id));
    const target = radialTargets(shown, links.filter((l) => ids.has(l.source) && ids.has(l.target)), cx, cy);
    shown.forEach((n) => { const t = target.get(n.id); n.x = t.x; n.y = t.y; });
    nodeSel.style("display", (d) => ids.has(d.id) ? null : "none").attr("transform", (d) => "translate(" + d.x + "," + d.y + ")");
    linkSel.style("display", (d) => ids.has(d.source) && ids.has(d.target) ? null : "none")
      .attr("x1", (d) => pos(d.source).x).attr("y1", (d) => pos(d.source).y)
      .attr("x2", (d) => pos(d.target).x).attr("y2", (d) => pos(d.target).y);
    orientLabels();
    fit();
  }
  layout();
  // A requirement no design point is judged against: drawn hollow, with a dashed outline.
  const judgedReqs = new Set(links.filter((e) => e.type === "assess").map((e) => e.target));
  nodeSel.classed("unjudged", (d) => d.kind === "requirement" && !judgedReqs.has(d.id));
  nodeSel.filter((d) => d.kind === "requirement" && !judgedReqs.has(d.id)).select("title")
    .text((d) => d.req + ": " + d.text + " (no design point is judged against it)");
  const toggle = document.getElementById("show-all");
  if (toggle) toggle.addEventListener("change", () => { showAll = toggle.checked; layout(); });

  // The active view: the trajectory (every step's point, or the selected step's), one alternative, or the compare
  // view (every alternative). Explored dimensions and values stay coloured in every view; the point shown is outlined.
  let view = "adrs", selected = null, selectedStep = null, selectedAlt = null, selectedOption = null;
  const explored = (d) => d.kind === "value" ? pointValues.has(d.id) : d.kind === "dimension" ? exploredDims.has(d.id) : true;
  linkSel.classed("explored", (d) => (d.type === "has_value" && pointValues.has(d.target))
    || (d.type === "domain" && exploredDims.has(d.target)));
  const stepOf = (n) => steps.find((s) => s.step === n);
  function shownPoint() {
    const lit = new Set();
    const add = (s) => { if (!s) return; lit.add(pid(s.step)); Object.values(s.point).forEach((v) => lit.add(v)); };
    if (view === "trajectory") { if (selectedStep !== null) add(stepOf(selectedStep)); return lit; }
    if (view === "adrs" && selectedOption) {
      const o = options.get(selectedOption); Object.values(o.point).forEach((v) => lit.add(v)); if (o.step) lit.add(pid(o.step));
      return lit;
    }
    alts.filter((a) => view === "compare" || (view === "adrs" && a.id === selectedAlt)).forEach((a) => {
      add(stepOf(a.step)); a.choices.forEach((c) => c.value && lit.add(c.value)); });
    return lit;
  }
  function applyView() {
    const lit = shownPoint();
    nodeSel.classed("greyed", (d) => !explored(d)).classed("in-point", (d) => lit.has(d.id))
      .select("path.shape").attr("fill", (d) => explored(d) ? nodeColor(d) : COLOR.muted)
      .attr("stroke", (d) => d.id === selected || lit.has(d.id) ? COLOR.fg : d.kind === "dimension" ? "#fff" : "none")
      .attr("stroke-width", (d) => d.id === selected ? 3 : lit.has(d.id) ? 2.2 : 1.5)
      .attr("transform", (d) => lit.has(d.id) ? "scale(1.45)" : null);
    // The point shown: its links to its values and to the requirements stand out.
    linkSel.classed("shown", (d) => (d.type === "member" && lit.has(d.target)) || (d.type === "assess" && lit.has(d.source)));
    document.querySelectorAll("[data-step]").forEach((el) =>
      el.classList.toggle("sel", view === "trajectory" && selectedStep !== null && Number(el.dataset.step) === selectedStep));
    document.querySelectorAll(".solution").forEach((el) => el.classList.toggle("sel", el.dataset.alt === selectedAlt));
    document.querySelectorAll(".option").forEach((el) => el.classList.toggle("sel", el.dataset.option === selectedOption));
  }
  // A selected node's lineage in the tree (domain -> dimension -> value -> design point -> requirement): its
  // ancestors up to the centre, and the paths down from it through design points to the requirements they are
  // judged against. A requirement lights the points judged against it and their ancestors.
  function lineage(id) {
    const keep = new Set([id, "domain"]);
    const up = (vid) => { keep.add(vid); const v = data.values[vid]; if (v) keep.add(v.dimension); };
    const pointUp = (p) => { keep.add(p); (byId.get(p).values || []).forEach(up); };
    const pointsWith = (vid) => links.filter((e) => e.type === "member" && e.source === vid).forEach((e) => keep.add(e.target));
    const n = byId.get(id);
    if (!n) return keep;
    if (n.kind === "domain") { pointValues.forEach(up); steps.forEach((s) => keep.add(pid(s.step))); }
    else if (n.kind === "dimension") (data.dimensions[id].values || []).filter((v) => pointValues.has(v))
      .forEach((v) => { up(v); pointsWith(v); });
    else if (n.kind === "value") { up(id); pointsWith(id); }
    else if (n.kind === "point") pointUp(id);
    else if (n.kind === "requirement") links.filter((e) => e.type === "assess" && e.target === id).forEach((e) => pointUp(e.source));
    if (n.kind !== "requirement")  // down to the requirements the kept points are judged against
      links.filter((e) => e.type === "assess" && keep.has(e.source)).forEach((e) => keep.add(e.target));
    return keep;
  }
  function highlight(id) {
    const keep = lineage(id);
    nodeSel.classed("dim-out", (d) => !keep.has(d.id));
    linkSel.classed("dim-out", (d) => !(keep.has(d.source) && keep.has(d.target)))
      .classed("on-path", (d) => d.type !== "relation" && keep.has(d.source) && keep.has(d.target));
  }
  const HINT = '<p class="hint">Select anything in the graph or the text (a dimension, a value, a design point, a requirement, an alternative or an option) to see what it is and the part it plays in this rationale.</p>';
  function clearSelection() {
    selected = null; selectedStep = null; selectedAlt = null; selectedOption = null;
    nodeSel.classed("dim-out", false); linkSel.classed("dim-out", false).classed("on-path", false);
    document.querySelectorAll(".chip.sel").forEach((c) => c.classList.remove("sel"));
    document.getElementById("info").innerHTML = HINT;
    applyView();
  }
  // The details panel: every kind of element reads the same way: what it is (kind, name, one sentence), then
  // sections named as on the page (in the decisions, in the alternatives, in the trajectory, requirements, sources).
  const EXPLAIN = data.mode === "explain";
  const link = (n) => n.href ? '<p class="info-link"><a class="open-page" href="' + esc(n.href) + '">Open its page in the wiki →</a></p>' : "";
  const vlabel = (vid) => { const v = data.values[vid]; return v ? '<span data-id="' + esc(v.id) + '" class="vref">' + esc(v.label) + "</span>" : "—"; };
  const dlabel = (did) => { const x = data.dimensions[did]; return x ? '<span data-id="' + esc(x.id) + '" class="dref">' + esc(x.label) + "</span>" : "—"; };
  const rlabel = (rid) => '<span data-id="r:' + esc(rid) + '" class="vref">' + esc(rid) + "</span>";
  const pair = (did, vid) => dlabel(did) + " → " + vlabel(vid);
  const head = (kind, title, sub) => '<div class="kind">' + kind + "</div><h2>" + title + "</h2>" + (sub ? '<p class="info-sub">' + sub + "</p>" : "");
  const sec = (title, body) => body ? '<h3 class="info-h">' + esc(title) + "</h3>" + body : "";
  const list = (items) => items.length ? "<ul>" + items.map((i) => "<li>" + i + "</li>").join("") + "</ul>" : "";
  const para = (text) => text ? "<p>" + text + "</p>" : "";
  const judgedChip = (rid, j) => '<span class="j j-' + esc(j) + '" data-id="r:' + esc(rid) + '">' + esc(rid) + " " + esc(j) + "</span>";
  const judgedWord = (j) => '<span class="j j-' + esc(j) + '">' + esc(j) + "</span>";  // inside a requirement's own panel
  const chips = (assessment) => { const e = Object.entries(assessment || {}); return e.length ? '<div class="judged">' + e.map(([r, j]) => judgedChip(r, j)).join("") + "</div>" : ""; };
  const stepChip = (s) => '<span class="node-chip vb-' + esc(s.verdict) + '" data-step-ref="' + s.step + '" title="' + esc(s.verdict) + '">#' + s.step + "</span>";
  const MEANS = {
    strong: "it meets every constraint and serves every requirement at least partly",
    mixed: "good on some requirements, but it misses one or carries a conflict",
    weak: "it breaks a constraint or misses a key requirement",
    grounded: "the requirements call for these values and what is known supports them",
    partial: "only part of that holds: the requirements or what is known support it, not both",
    ungrounded: "neither the requirements nor what is known support it" };
  const STATUS = { accepted: "The sources accept this value.", mixed: "The sources are divided on this value.",
    rejected: "The sources reject this value.", outcome: "The sources report this as an outcome." };
  const STANCE = { accepts: "accepts it", rejects: "rejects it", supports: "supports it", both: "both accepts and rejects it" };
  function phrase(s) {
    const p = s.parent ? "#" + s.parent : "";
    return { seed: "Seed of approach " + s.approach, exploit: "Refined " + p + (s.approach ? " (approach " + s.approach + ")" : ""),
      explore: "New approach " + s.approach + (s.parent ? ", started from " + p : ""), ablate: "Ablation of " + p + ": which value made it work?",
      solution: "The solution as one design point", region: "A region of " + p + ": part of the solution",
      contrast: "A contrast on " + p + ": one option changed" }[s.move] || s.move;
  }
  function moveItems(s) {
    if (["seed", "solution", "region"].includes(s.move) || !s.parent || !(s.diff || []).length)
