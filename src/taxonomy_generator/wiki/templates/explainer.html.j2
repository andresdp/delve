  }
  document.querySelectorAll(".step-h, .region, .node-chip, .heat-h, td.h, .story-step, .opt").forEach((el) => el.addEventListener("click", (e) => {
    if (e.target.closest("a") || e.target.closest("[data-node]")) return;
    selectStep(Number(el.dataset.step));
  }));
  // The ADRs tab: an alternative or an option lights its point in the graph.
  function altInfo(a) {
    const s = stepOf(a.step);
    return head(EXPLAIN ? "The solution" : "Alternative" + (a.approach ? " · from approach " + esc(a.approach) : ""), esc(altName(a)), esc(a.summary || ""))
      + sec("Composed of", list((a.parts || []).map((p) => adrRef(p.adr, p.name)
          + "<br>" + Object.entries(p.point).map(([d, v]) => pair(d, v)).join("<br>"))))
      + sec("Requirements", s ? chips(s.assessment) : "")
      + sec("Left open", list(a.open.map((o) => dlabel(o.dimension) + (o.reason ? ': <span class="muted">' + esc(o.reason) + "</span>" : ""))))
      + sec("Each choice", list(a.choices.map((c) => pair(c.dimension, c.value) + (c.drivers.length ? " · for " + c.drivers.map(rlabel).join(", ") : "")
          + (c.reason ? '<br><span class="muted">' + esc(c.reason) + "</span>" : "") + (c.quote ? '<div class="quote">“' + esc(c.quote) + "”</div>" : "")
          + (c.evidence.length ? '<br><span class="ev">Cited evidence: ' + ev(c.evidence) + "</span>" : ""))));
  }
  function optionInfo(o) {
    const { r } = adrOptions.find((x) => x.o === o) || {};
    return head("Option · " + (r ? esc(r.id) + " " + esc(r.title) : "ADR"), esc(o.name), statusBadge(o) + " " + esc(o.reason || ""))
      + sec("Values", list(Object.entries(o.point).map(([d, v]) => pair(d, v))))
      + sec("Pros", list(o.pros.map(esc))) + sec("Cons", list(o.cons.map(esc)))
      + (o.quotes && o.quotes.length ? sec("In the solution's words", o.quotes.map((q) => '<div class="quote">“' + esc(q) + "”</div>").join("")) : "")
      + (r ? sec("The decision it answers", para(esc(r.context)) + '<div class="judged">' + r.drivers.map((d) => '<span class="chip-sm">' + rlabel(d) + "</span>").join(" ") + "</div>") : "");
  }
  function showInfo(html) {
    const info = document.getElementById("info"); info.innerHTML = html; info.scrollTop = 0;
    info.querySelectorAll("[data-id]").forEach((el) => el.addEventListener("click", () => select(el.dataset.id)));
    info.querySelectorAll("[data-step-ref]").forEach((el) => el.addEventListener("click", () => selectStep(Number(el.dataset.stepRef))));
    info.querySelectorAll("a.adr-link").forEach((el) => el.addEventListener("click", () => {
      if (view !== "adrs") document.querySelector('.tab[data-tab="adrs"]')?.click(); }));
  }
  document.querySelectorAll(".solution").forEach((el) => el.addEventListener("click", (e) => {
    if (e.target.closest("a") || e.target.closest("[data-node]")) return;
    const a = alts.find((x) => x.id === el.dataset.alt); if (!a) return;
    selected = null; selectedOption = null; selectedAlt = a.id;
    nodeSel.classed("dim-out", false); linkSel.classed("dim-out", false).classed("on-path", false);
    applyView(); showInfo(altInfo(a));
  }));
  document.querySelectorAll(".option").forEach((el) => el.addEventListener("click", (e) => {
    if (e.target.closest("a") || e.target.closest("[data-node]")) return;
    const o = options.get(el.dataset.option); if (!o) return;
    selected = null; selectedAlt = null; selectedOption = o.key;
    nodeSel.classed("dim-out", false); linkSel.classed("dim-out", false).classed("on-path", false);
    applyView(); showInfo(optionInfo(o));
  }));
  // The lanes: an arrow from each point's parent to it (refine along a lane, a new approach across lanes,
  // an ablation dotted).
  function overlay(wrapSel, svgSel) {
    const wrap = document.querySelector(wrapSel), svgEl = wrap && wrap.querySelector(svgSel);
    if (!wrap || !svgEl || !wrap.offsetParent) return null;
    svgEl.setAttribute("width", wrap.scrollWidth); svgEl.setAttribute("height", wrap.scrollHeight);
    const box = wrap.getBoundingClientRect();
    const at = (el, side) => { const r = el.getBoundingClientRect();
      return [(side === "left" ? r.left : side === "right" ? r.right : r.left + r.width / 2) - box.left + wrap.scrollLeft,
        r.top + r.height / 2 - box.top]; };
    return { svgEl, at };
  }
  const MOVE_COLOR = (m) => m === "explore" || m === "contrast" ? COLOR.novel : m === "seed" || m === "solution" ? COLOR.dimension : COLOR.accent;
  function drawLanes() {
    const o = overlay(".lanes-wrap", "svg.lane-arrows"); if (!o) return;
    let html = "";
    steps.forEach((s) => {
      if (!s.parent) return;
      const a = document.querySelector('.node-chip[data-step="' + s.parent + '"]'), b = document.querySelector('.node-chip[data-step="' + s.step + '"]');
      if (!a || !b) return;
      const [x0, y0] = o.at(a, "right"), [x1, y1] = o.at(b, "left");
      const mx = (x0 + x1) / 2, dash = s.move === "ablate" ? "2,3" : s.move === "explore" ? "6,4" : null;
      html += '<path d="M' + x0 + "," + y0 + " C" + mx + "," + y0 + " " + mx + "," + y1 + " " + x1 + "," + y1 + '" fill="none" stroke="'
        + MOVE_COLOR(s.move) + '" stroke-width="1.8"' + (dash ? ' stroke-dasharray="' + dash + '"' : "") + ' marker-end="url(#lane-arrow)"></path>';
    });
    o.svgEl.innerHTML = '<defs><marker id="lane-arrow" viewBox="0 -5 10 10" refX="9" refY="0" markerWidth="6" markerHeight="6" orient="auto">'
      + '<path d="M0,-5L10,0L0,5" fill="' + COLOR.muted + '"></path></marker></defs>' + html;
  }
  // The questions, options and criteria: a link from each option to each requirement its point was judged against.
  const JUDGE_STYLE = { meets: [() => COLOR.accepted, null], partly: [() => COLOR.mixed, null], misses: [() => COLOR.rejected, "5,4"] };
  function drawQoc() {
    const o = overlay(".qoc-wrap", "svg.qoc-links"); if (!o) return;
    let html = "";
    document.querySelectorAll(".opt[data-qoc]").forEach((el) => {
      const [qi, oi] = el.dataset.qoc.split(":").map(Number), opt = (data.qoc[qi] || { options: [] }).options[oi];
      if (!opt) return;
      const [x0, y0] = o.at(el, "right");
      Object.entries(opt.assessment || {}).forEach(([rid, judged]) => {
        const c = document.querySelector('.crit[data-crit="' + rid + '"]'); if (!c) return;
        const [x1, y1] = o.at(c, "left"), st = JUDGE_STYLE[judged] || [() => COLOR.muted, null], mx = (x0 + x1) / 2;
        html += '<path data-from="' + el.dataset.qoc + '" d="M' + x0 + "," + y0 + " C" + mx + "," + y0 + " " + mx + "," + y1 + " " + x1 + "," + y1
          + '" fill="none" stroke="' + st[0]() + '" stroke-width="1.5" stroke-opacity="' + (opt.specific ? 0.8 : 0.14) + '"'
          + (st[1] ? ' stroke-dasharray="' + st[1] + '"' : "") + "></path>";
      });
    });
    o.svgEl.innerHTML = html;
  }
  document.querySelectorAll(".opt[data-qoc]").forEach((el) => {
    const mark = (on) => document.querySelectorAll('svg.qoc-links path[data-from="' + el.dataset.qoc + '"]')
      .forEach((p) => p.classList.toggle("traced", on));
    el.addEventListener("mouseenter", () => mark(true)); el.addEventListener("mouseleave", () => mark(false));
  });
  function drawTrajectory() { drawLanes(); drawQoc(); drawLineage(); }
  document.querySelector("details.grid-details")?.addEventListener("toggle", drawLineage);
  // The lineage: an arc from each step's parent column to its own, above the grid.
  function drawLineage() {
    const svgL = document.querySelector("svg.lineage"); if (!svgL) return;
    const box = svgL.getBoundingClientRect(), table = document.querySelector("table.traj");
    svgL.style.width = table.scrollWidth + "px";
    const x = (n) => { const th = document.querySelector('.step-h[data-step="' + n + '"]'); if (!th) return null;
      const r = th.getBoundingClientRect(); return r.left - box.left + r.width / 2; };
    const colorOf = (m) => m === "explore" || m === "contrast" ? COLOR.novel : m === "exploit" || m === "region" ? COLOR.accent : COLOR.dimension;
    let html = "";
    steps.forEach((s) => {
      const x1 = x(s.step); if (x1 === null) return;
      html += '<circle cx="' + x1 + '" cy="40" r="3" fill="' + colorOf(s.move) + '"></circle>';
      const x0 = s.parent ? x(s.parent) : null; if (x0 === null) return;
      const h = Math.min(36, 10 + Math.abs(x1 - x0) / 8);
      html += '<path d="M' + x0 + ",40 C" + x0 + "," + (40 - h) + " " + x1 + "," + (40 - h) + " " + x1 + ',40" fill="none" stroke="'
        + colorOf(s.move) + '" stroke-width="1.6"></path>';
    });
    svgL.innerHTML = html;
  }
  document.querySelectorAll("main [data-node]").forEach((el) => el.addEventListener("click", (e) => {
    if (e.target.closest("a")) return;  // a wiki link opens its page
    e.preventDefault(); select(el.dataset.node);
  }));

  // Tabs: switching shows the tab's panel, re-lights the graph and drops the selection fade.
  document.querySelectorAll(".tab").forEach((t) => t.addEventListener("click", () => {
    view = t.dataset.tab;
    document.querySelectorAll(".tab").forEach((x) => x.setAttribute("aria-selected", x === t ? "true" : "false"));
    document.querySelectorAll(".panel").forEach((p) => { p.hidden = p.dataset.panel !== view; });
    clearSelection();
    if (view === "trajectory") drawTrajectory();
  }));
  applyView();
  drawTrajectory();
  let lastSize = width() + "x" + height(), timer = null;
  window.addEventListener("resize", () => { clearTimeout(timer); timer = setTimeout(() => {
    const size = width() + "x" + height(); if (size !== lastSize) { lastSize = size; fit(); drawTrajectory(); } }, 200); });
  document.addEventListener("themechange", () => { readColors(); styleLinks(); applyView(); drawTrajectory(); });
})();
</script>
</body>
</html>
