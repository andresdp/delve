        + link(n);
    }
    if (n.kind === "requirement") {
      const rq = data.requirements.find((r) => r.id === n.req) || {};
      const adrsFor = (data.adrs || []).filter((r) => r.drivers.includes(n.req));
      const judged = steps.filter((s) => s.assessment && s.assessment[n.req]);
      const drives = [];
      alts.forEach((a) => a.choices.filter((c) => c.drivers.includes(n.req)).forEach((c) =>
        drives.push("<b>" + esc(a.id) + "</b> " + pair(c.dimension, c.value))));
      return head("Requirement · " + esc(rq.kind || "requirement") + (rq.attribute ? ": " + esc(rq.attribute) : ""), esc(n.req), esc(n.text))
        + sec("In the decisions", adrsFor.length
            ? list(adrsFor.map((r) => adrRef(r.id, r.title) + ": "
                + r.options.filter((o) => o.status === "chosen").map((o) => "<b>" + esc(o.name) + "</b>" + (EXPLAIN ? "" : " (" + esc(o.in.join(", ")) + ")")).join("; ")))
            : para('<span class="muted">No ADR addresses it.</span>'))
        + sec(altsTitle, list(alts.map((a) => { const s = stepOf(a.step), j = s && s.assessment ? s.assessment[n.req] : null;
            return "<b>" + esc(a.id) + "</b> " + (j ? judgedWord(j) : '<span class="muted">not judged</span>'); })))
        + sec("In the trajectory", judged.length
            ? para(judged.length + " design point" + (judged.length > 1 ? "s were" : " was") + " judged against it:")
              + '<div class="judged">' + judged.map((s) => '<span class="pair-chip">' + stepChip(s) + judgedWord(s.assessment[n.req]) + "</span>").join(" ") + "</div>"
