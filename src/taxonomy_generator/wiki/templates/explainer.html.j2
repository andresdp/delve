  const adrRef = (id, title) => '<a href="#adr-' + esc(id) + '" class="adr-link">' + esc(id) + "</a> · " + esc(title);
  const optLine = ({ r, o }) => adrRef(r.id, r.title) + ": <b>" + esc(o.name) + "</b> " + statusBadge(o);
  const altsTitle = EXPLAIN ? "In the solution" : "In the alternatives";
  const ev = (list) => list.map((e) => esc(e.doc) + (e.stance ? " (" + esc(e.stance) + ")" : "")).join(", ");
  const taking = (vid) => steps.filter((s) => Object.values(s.point).includes(vid));

  function details(n) {
    if (n.kind === "dimension") {
      const dm = data.dimensions[n.id];
      const explored = (dm.values || []).filter((v) => pointValues.has(v));
      return head("Dimension · a design concern", esc(n.label), esc(n.question || ""))
        + sec("In the decisions", list(adrOptions.filter(({ o }) => o.point[n.id]).map((x) => optLine(x) + "<br>" + pair(n.id, x.o.point[n.id]))))
        + sec(altsTitle, list(alts.map((a) => {
            const c = a.choices.find((x) => x.dimension === n.id), o = a.open.find((x) => x.dimension === n.id);
            return "<b>" + esc(a.id) + "</b> " + (c ? vlabel(c.value) + (c.reason ? '<br><span class="muted">' + esc(c.reason) + "</span>" : "")
              : o ? "leaves it open" + (o.reason ? ': <span class="muted">' + esc(o.reason) + "</span>" : "") : '<span class="muted">does not settle it</span>');
          })))
        + sec("In the trajectory", explored.length
            ? para(explored.length + " of the " + dm.values.length + " values the space offers were taken by some design point:")
              + list(explored.map((v) => vlabel(v) + " " + taking(v).map(stepChip).join("")))
            : para('<span class="muted">No design point settled this dimension.</span>'))
        + sec("Relations", list(data.relations.filter((r) => r.source === n.id || r.target === n.id)
            .map((r) => dlabel(r.source) + " <em>" + esc(r.type) + "</em> " + dlabel(r.target) + ' <span class="muted">(in the space)</span>')
            .concat(alts.flatMap((a) => a.relations.filter((r) => r.source === n.id || r.target === n.id).map((r) =>
              (r.source ? dlabel(r.source) : esc(r.source_label)) + " <em>" + esc(r.type) + "</em> " + (r.target ? dlabel(r.target) : esc(r.target_label))
              + ' <span class="muted">(' + esc(a.id) + (r.holds ? ": holds" : ": does not hold") + (r.note ? ", " + esc(r.note) : "") + ")</span>")))))
        + link(n);
    }
    if (n.kind === "value") {
      const points = taking(n.id);
      const roles = [];
      alts.forEach((a) => {
        const c = a.choices.find((x) => x.value === n.id), k = a.considered.find((x) => x.value === n.id);
        if (c) roles.push("<b>Chosen in " + esc(a.id) + "</b>" + (c.drivers.length ? " for " + c.drivers.map(rlabel).join(", ") : "")
          + (c.reason ? "<br>" + esc(c.reason) : "") + (c.quote ? '<div class="quote">“' + esc(c.quote) + "”</div>" : "")
          + (c.evidence.length ? '<br><span class="ev">Cited evidence: ' + ev(c.evidence) + "</span>" : ""));
        else if (k) roles.push("<b>Weighed and set aside in " + esc(a.id) + "</b>" + (k.reason ? "<br>" + esc(k.reason) : ""));
      });
      return head("Value · an option for " + dlabel(n.dimension), esc(n.label), esc(n.description || ""))
        + (n.status && STATUS[n.status] ? para('<span class="badge ' + esc(n.status) + '">' + esc(n.status) + "</span> " + STATUS[n.status]) : "")
        + sec("In the decisions", list(adrOptions.filter(({ o }) => Object.values(o.point).includes(n.id)).map(optLine)))
        + sec(altsTitle, list(roles))
        + sec("In the trajectory", points.length
            ? para("Taken by " + points.length + " design point" + (points.length > 1 ? "s" : "") + ": " + points.map(stepChip).join("")
              + "<br>First tried in #" + points[0].step + ": " + esc(phrase(points[0])) + ".")
            : para('<span class="muted">No design point took it: the space offers it, but the agent did not try it.</span>'))
        + sec("What the sources say", list(n.sources.map((s) => (s.href ? '<a href="' + esc(s.href) + '">' + esc(s.label) + "</a>" : esc(s.label))
            + (s.stance ? " " + esc(STANCE[s.stance] || s.stance) : "")))
