        + (s.alternative ? '<br><span class="alt-chip">' + (EXPLAIN ? "This is the solution." : "It became alternative " + esc(s.alternative) + ".") + "</span>" : ""))
      + sec("Thought", para(esc(s.why)))
      + sec("Move", list(moveItems(s)))
      + sec("Observed", para(esc(s.observation)))
      + sec("Requirements", chips(s.assessment))
      + (["seed", "solution", "region"].includes(s.move) ? "" : sec("The whole point", list(Object.entries(s.point).map(([d, v]) => pair(d, v)))))
      + sec("In the decisions", list(inAdrs.map(optLine)))
      + (data.wiki ? sec("What the sources say", s.attested_by.length
          ? para("Attested by " + s.attested_by.map((a) => a.href ? '<a href="' + esc(a.href) + '">' + esc(a.label) + "</a>" : esc(a.label)).join("; ") + ".")
