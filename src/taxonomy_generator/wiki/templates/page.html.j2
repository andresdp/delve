<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ page.title }} · {{ name }}</title>
<link rel="stylesheet" href="{{ css }}">
<link rel="icon" href="{{ icon }}" type="image/svg+xml">
<script>
  // Theme: the reader's choice (kept in this browser) or the system setting.
  (function () { try { var t = localStorage.getItem("delve-wiki-theme"); if (t) document.documentElement.dataset.theme = t; } catch (e) {} })();
</script>
</head>
<body class="page-{{ page.kind }}">
<header class="top">
  <a class="brand" href="{{ home }}"><img src="{{ icon }}" alt="" class="brand-icon" width="32" height="32">{% if case_icon %}<img src="{{ case_icon }}" alt="" class="brand-icon" width="32" height="32">{% endif %}{{ name }}</a>
  <nav>
    {% for q in quick %}<a href="{{ q.href }}">{{ q.label }}</a>{% endfor %}
  </nav>
  <a class="graph-btn" href="{{ graph }}">Graph view</a>
  <button class="theme-btn" id="theme-toggle" type="button" title="Switch light / dark mode" aria-label="Switch light / dark mode">◐</button>
</header>
<div class="layout">
  <aside class="sidebar">
    <a href="{{ home }}"><strong>Index</strong></a>
    {% for shelf in nav %}
    <details{% if shelf.open %} open{% endif %}>
      <summary>{{ shelf.label }} ({{ shelf["items"]|length }})</summary>
      <ul>
        {% for item in shelf["items"] %}
        <li><a href="{{ item.href }}"{% if item.current %} class="current"{% endif %}>{% if item.status %}<span class="dot {{ item.status }}"></span>{% endif %}{{ item.title }}</a></li>
        {% endfor %}
      </ul>
    </details>
    {% endfor %}
  </aside>
  <main>
    {% if page.kind != "index" %}
    {% if case_icon %}<img src="{{ case_icon }}" alt="Case study" class="page-case-icon" width="48" height="48">{% endif %}
    <div class="kind">{{ page.kind }}{% if status %} · <span class="badge {{ status }}">{{ status }}</span>{% endif %}{% if page.frontmatter.group %} · <span class="badge {{ page.frontmatter.group }}">{{ page.frontmatter.group }}</span>{% endif %}</div>
    <h1>{{ page.title }}</h1>
    {% if properties %}
    <table class="props">
      {% for row in properties %}
      <tr><th>{{ row.key }}</th><td>{% if row.raw %}<span class="badge {{ row.raw }}">{{ row.raw }}</span>{% else %}{{ row.value|safe }}{% endif %}</td></tr>
      {% endfor %}
    </table>
    {% endif %}
    {% endif %}
    {{ body|safe }}
    {% if tags %}<div class="tags">{% for t in tags %}<span>{{ t }}</span>{% endfor %}</div>{% endif %}
    <footer>Generated by DelveDSpace from the run's data (no LLM rewriting). Markdown source: <code>wiki/{{ page.path }}.md</code></footer>
  </main>
</div>
<script>
  (function () {
    var root = document.documentElement, btn = document.getElementById("theme-toggle");
    function current() {
      return root.dataset.theme || (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
    }
    function label() { btn.textContent = current() === "dark" ? "☀" : "☾"; }
    btn.addEventListener("click", function () {
      var next = current() === "dark" ? "light" : "dark";
      root.dataset.theme = next;
      try { localStorage.setItem("delve-wiki-theme", next); } catch (e) {}
      label();
      document.dispatchEvent(new CustomEvent("themechange"));
    });
    label();
  })();
</script>
</body>
</html>
