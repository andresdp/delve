    {"id": "ADR1", "title": "<the decision>", "drivers": ["C1"], "context": "<what the drivers demand>",
     "options": [
       {"id": "O1", "name": "<short name>", "values": ["<dimension 1>: <value 1.1>"], "status": "chosen", "in": ["A1"], "step": 4,
        "pros": ["<…>"], "cons": ["<…>"], "reason": "<why A1 takes it>"},
       {"id": "O2", "name": "<short name>", "values": ["<dimension 1>: <value 1.2>"], "status": "chosen", "in": ["B1"], "step": 2,
        "pros": ["<…>"], "cons": ["<…>"], "reason": "<why B1 takes it>"}
     ]},
    {"id": "ADR2", "title": "<the decision>", "drivers": ["R1", "Q1"], "context": "<…>",
     "options": [
       {"id": "O1", "name": "<short name>", "values": ["<dimension 2>: <value 2.1>", "<dimension 3>: <value 3.2>"], "status": "chosen", "in": ["A1"], "step": 4,
        "pros": ["<…>"], "cons": ["<…>"], "reason": "<…>"},
       {"id": "O2", "name": "<short name>", "values": ["<dimension 2>: <value 2.2>"], "status": "chosen", "in": ["B1"], "step": 2,
        "pros": ["<…>"], "cons": ["<…>"], "reason": "<…>"},
